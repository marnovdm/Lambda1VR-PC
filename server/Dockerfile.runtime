FROM ubuntu:22.04

RUN apt-get update \
	&& DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
		ca-certificates libasound2 libgcc-s1 libstdc++6 \
	&& apt-get clean \
	&& find /var/lib/apt/lists -mindepth 1 -depth -delete

WORKDIR /server
EXPOSE 27015/udp

ENTRYPOINT ["/server/xash"]
CMD ["-dedicated", "-game", "sevenkewp", "-port", "27015", "+maxplayers", "8", "+exec", "server.cfg", "+map", "c1a0"]
